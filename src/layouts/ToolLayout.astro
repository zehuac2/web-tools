---
import { css } from 'styled-system/css';
import { REPO_URL, TOOLS } from '@/meta';
import '@/styles/global.css';
import 'styled-system/styles.css';

export interface Props {
  title: string;
  description: string;
  glyph: string;
  activeSlug?: string;
}

const { title, description, glyph, activeSlug } = Astro.props;

// Astro appends a trailing slash to BASE_URL; strip it so path joins stay
// unambiguous regardless of that behavior.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · Web Tools</title>
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <div
      class={css({
        minHeight: { base: '[100vh]', _print: 'auto' },
        backgroundImage: {
          base: 'linear-gradient(135deg, var(--colors-bg-canvas), var(--colors-bg-subtle))',
          _print: 'none',
        },
      })}
    >
      <header
        class={css({
          position: 'sticky',
          top: '0',
          zIndex: '[10]',
          borderBottomWidth: '[1px]',
          borderBottomStyle: 'solid',
          borderBottomColor: 'border.default',
          bg: 'surface.glass',
          backdropFilter: '[blur(10px)]',
          display: { _print: 'none' },
        })}
      >
        <div
          class={css({
            maxWidth: '[1200px]',
            margin: '[0 auto]',
            px: { base: '6', xsDown: '4' },
            py: { base: '4', xsDown: '3' },
            display: 'flex',
            flexWrap: 'wrap',
            minWidth: '0',
            alignItems: 'center',
            justifyContent: 'space-between',
            gap: '4',
          })}
        >
          <a
            href={`${base}/`}
            class={css({
              display: 'flex',
              alignItems: 'center',
              gap: '3',
              textDecoration: 'none',
              color: 'fg.default',
            })}
          >
            <div
              class={css({
                width: '[36px]',
                height: '[36px]',
                display: 'grid',
                placeItems: 'center',
                borderRadius: 'card',
                bg: 'brand.solid',
                color: 'fg.onBrand',
                fontWeight: 'bold',
                lineHeight: '[1]',
                flexShrink: 0,
              })}
              aria-hidden="true"
            >
              {glyph}
            </div>
            <h1
              class={css({
                margin: '0',
                fontSize: 'ui20',
                fontWeight: 'ui',
              })}
            >
              {title}
            </h1>
          </a>

          <nav
            class={css({
              display: 'flex',
              flexWrap: 'wrap',
              alignItems: 'center',
              gap: '4',
            })}
          >
            {
              TOOLS.map((tool) => (
                <a
                  href={`${base}/${tool.slug}`}
                  aria-current={tool.slug === activeSlug ? 'page' : undefined}
                  class={css({
                    color: { base: 'fg.muted', _hover: 'fg.default' },
                    fontWeight: tool.slug === activeSlug ? 'ui' : 'medium',
                    textDecoration: 'none',
                    fontSize: 'ui14',
                    _hover: { textDecoration: 'underline' },
                  })}
                >
                  {tool.title}
                </a>
              ))
            }

            <a
              class={css({
                color: 'fg.muted',
                textDecoration: 'none',
                fontSize: 'ui14',
                fontWeight: 'medium',
                _hover: {
                  color: 'fg.default',
                  textDecoration: 'underline',
                },
              })}
              href={REPO_URL}
              target="_blank"
              rel="noreferrer"
            >
              GitHub
            </a>
          </nav>
        </div>
      </header>

      <main
        class={css({
          maxWidth: '[1200px]',
          margin: '[0 auto]',
          px: { base: '6', xsDown: '4', _print: '0' },
          py: { base: '8', xsDown: '5', _print: '0' },
        })}
      >
        <slot />
      </main>
    </div>
  </body>
</html>
